# ========== Секреты и локальное окружение ==========
# .env хранит JWT_SECRET, ADMIN_REGISTER_TOKEN, DATABASE_URL — коммит запрещён.
# Закомментированные строки в старом варианте означали, что .env МОГ попасть в git.
# .env
# .env.*
# !.env.example
# !.env.sample
# !.env.template

# ========== Артефакты сборки Go ==========
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/api
/server
bin/
out/
dist/

# Локальные workspace-файлы Go (мешают CI, не коммитим)
go.work
go.work.sum

# ========== Локальные инструменты разработчика ==========
.bin/
.tmp/
tmp/

# ========== Тесты и профилирование ==========
coverage.html
cover.html
pprof/

# ========== IDE и редакторы ==========
.idea/
# Командные настройки VS Code шарим, персональные (launch.json и т.п.) — нет
# .vscode/*
# !.vscode/settings.json
# !.vscode/extensions.json
*.swp
*.swo
*.swn
*~

# ========== Логи ==========
*.log
nohup.out

# ========== Операционные системы ==========
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# ========== Docker ==========
# Персональные оверрады (порты, тома) не коммитим; базовый compose — коммитим
docker-compose.override.yml