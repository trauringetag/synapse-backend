# HTTP
APP_PORT=8080

# Порт хоста, опубликованный Docker
API_HOST_PORT=8080
APP_ENV=synapse-backend

# PostgreSQL
POSTGRES_USER=synapse-default-user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=synapse-default-db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Отладка
# DATABASE_URL=postgres://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/CHANGE_ME_DB?sslmode=disable
# Docker-контейнер
DATABASE_URL=postgres://CHANGE_ME_USER:CHANGE_ME_PASSWORD@postgres:5432/CHANGE_ME_DB?sslmode=disable

# JWT
JWT_SECRET=CHANGE_ME_IMMEDIATELY__generate_a_64_byte_random_string_here_openssl_rand_base64_48

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Токен для регистрации администратора
ADMIN_REGISTER_TOKEN=CHANGE_ME_ADMIN_REGISTER_TOKEN

# Cookies (В рабочей среде параметр COOKIE_SECURE должен иметь значение true / HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=

# CORS: источники, разделенные запятыми. Передача учётных данных (credentials) разрешена всегда.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Общие лимиты запросов для PostgreSQL
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=10
REFRESH_RATE_LIMIT=30
LOGOUT_RATE_LIMIT=10
AUTHENTICATED_RATE_LIMIT=600

RATE_LIMIT_CLEANUP_INTERVAL=1h
RATE_LIMIT_MAX_WINDOW_SECONDS=3600
# Режим развёртывания (SEC-03 fail-fast): development (по умолчанию) | staging | production.
# В production запуск падает, если JWT_SECRET дефолтный/плейсхолдер, COOKIE_SECURE=false
# или DATABASE_URL содержит sslmode=disable.
ENVIRONMENT=development

# SEC-05: whitelist доверенных reverse-прокси для X-Forwarded-For/X-Real-IP/True-Client-IP
# (CSV: точные IP или CIDR, например "10.0.0.0/8, 192.168.1.1").
# Пусто => заголовки игнорируются, используется r.RemoteAddr (защита от подмены IP).
TRUSTED_PROXIES=
