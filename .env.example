# HTTP
APP_PORT=8080

# Порт хоста, опубликованный Docker
API_HOST_PORT=8080
APP_ENV=synapse-backend

# PostgreSQL
POSTGRES_USER=synapse-default-user
POSTGRES_PASSWORD=synapse-default-password
POSTGRES_DB=synapse-default-db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://synapse-backend:synapse-default-password@postgres:5432/synapse-backend?sslmode=disable

# JWT
JWT_SECRET=change-me-to-a-long-random-secret

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Токен для регистрации администратора
ADMIN_REGISTER_TOKEN=change-me-admin-register-token

# Cookies (В рабочей среде параметр COOKIE_SECURE должен иметь значение true / HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=

# CORS: источники, разделенные запятыми. Передача учётных данных (credentials) разрешена всегда.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080